# ============================================================
# .gitignore — Grand Duta City SOJ (Next.js 16 / Vercel)
# Audited: 2026-04-10 | Deployment: Vercel via GitHub
# ============================================================

# ──────────────────────────────────────────────────────────
# NODE DEPENDENCIES
# Rebuilt automatically by Vercel/npm during CI
# ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ──────────────────────────────────────────────────────────
# NEXT.JS BUILD OUTPUT
# Re-generated on every Vercel build — never commit
# ──────────────────────────────────────────────────────────
.next/
/out/
/build/

# ──────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT ARTIFACTS
# Local Vercel CLI cache — not needed in repo
# ──────────────────────────────────────────────────────────
.vercel/

# ──────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS — CRITICAL SECURITY
# NEVER commit .env files containing API keys or secrets
# ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────────────────────
# TYPESCRIPT INCREMENTAL BUILD CACHE
# Auto-regenerated by tsc — bloats repo with binary data
# ──────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────────────────
# LOG FILES
# Crash logs and debug output — local diagnostics only
# ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ──────────────────────────────────────────────────────────
# OPERATING SYSTEM FILES
# macOS, Windows, Linux filesystem artifacts
# ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ──────────────────────────────────────────────────────────
# SECURITY CERTIFICATES & KEYS
# Never commit TLS/SSL keys or self-signed certs
# ──────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ──────────────────────────────────────────────────────────
# EDITOR & IDE CONFIGS (local only)
# .vscode/settings.json is purely a local Tailwind v4 lint
# suppressor — not needed by Vercel or teammates
# ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ──────────────────────────────────────────────────────────
# AI AGENT TOOLING (safe to exclude)
#
# .agents/skills/  → Markdown-only skill instruction files.
#                    Zero imports found in any .ts/.tsx source.
#                    Not read by Next.js, Vercel, or any API route.
#                    These are AI-assistant prompt libraries, not
#                    application code. Reinstallable via skills-lock.json.
#
# .playwright-mcp/ → Browser automation session logs (.log, .yml).
#                    MCP-generated at runtime, not app code.
#                    Confirmed not imported anywhere.
#
# NOTE: skills-lock.json IS kept (see KEPT section) so skills
#       can be restored deterministically from the lockfile.
# ──────────────────────────────────────────────────────────
.agents/
.playwright-mcp/

# ──────────────────────────────────────────────────────────
# TEST COVERAGE REPORTS
# Generated by testing runners — not needed in repo
# ──────────────────────────────────────────────────────────
/coverage/

# ──────────────────────────────────────────────────────────
# MISCELLANEOUS TEMP / CACHE
# ──────────────────────────────────────────────────────────
.cache/
.tmp/
*.bak
*.orig

.vercel
.env*
.kilo/

# ──────────────────────────────────────────────────────────
# KONFIGURASI MCP — MEMUAT RAHASIA
#
# .kiro/settings/mcp.json menyimpan API key server MCP (mis. SEMRUSH_API_KEY)
# dalam teks terbuka di blok `env`. Repo ini publik, jadi file itu TIDAK BOLEH
# ikut ter-commit. Sempat berstatus untracked dan hanya berjarak satu
# `git add -A` dari terkirim ke GitHub.
#
# Spesifikasi spec (.kiro/specs/) dan skill (.kiro/skills/) TETAP dilacak —
# hanya settings/ yang dikecualikan, karena di situlah kredensial berada.
# ──────────────────────────────────────────────────────────
.kiro/settings/mcp.json
