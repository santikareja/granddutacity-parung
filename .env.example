NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Secret aplikasi (WAJIB)
# ---------------------------------------------------------------------------
# Dipakai untuk TIGA hal sekaligus:
#   1. tanda tangan cookie sesi admin (HMAC-SHA256)
#   2. tanda tangan token CSRF
#   3. kunci turunan (scrypt) untuk enkripsi/dekripsi API key provider AI
#
# JANGAN PERNAH MEROTASI nilainya pada instalasi yang sudah berjalan:
# rotasi meng-invalidasi semua sesi aktif DAN membuat API key AI yang sudah
# tersimpan di tabel `ai_providers` tidak bisa didekripsi lagi.
#
# Instalasi lama (era Payload CMS): isi APP_SECRET dengan NILAI PAYLOAD_SECRET
# YANG SAMA. Kode masih membaca PAYLOAD_SECRET sebagai fallback, jadi keduanya
# boleh hidup berdampingan selama masa transisi.
# Minimal 8 karakter; gunakan string acak panjang (mis. `openssl rand -hex 32`).
APP_SECRET=

# Database SSL/TLS — CA certificate untuk validasi koneksi Postgres.
# Direkomendasikan untuk production agar terproteksi dari serangan MITM.
# Isi dengan CA certificate dari provider DB (Supabase/Neon/RDS).
# Tanpa ini, koneksi tetap SSL tapi sertifikat server TIDAK divalidasi.
DATABASE_SSL_CA=

# Connection string Postgres
DATABASE_URI=

# ---------------------------------------------------------------------------
# Cross-posting Tumblr (opsional) — backlink otomatis saat artikel dipublish
# ---------------------------------------------------------------------------
# OAuth 1.0a. Ambil dari https://www.tumblr.com/oauth/apps (consumer key/secret)
# lalu buat token akses (mis. via https://api.tumblr.com/console).
# Bila salah satu kosong, fitur cross-post dilewati rapi (tidak error).
# TUMBLR_BLOG_NAME: nama blog target, mis. "namablog" atau "namablog.tumblr.com".
# Uji koneksi via GET /api/admin/test-tumblr (sesi admin) sebelum publish pertama.
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
TUMBLR_BLOG_NAME=
